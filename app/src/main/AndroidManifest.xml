<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://tools.android.com/tools"
    package="com.example.syscm20">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Syscm20"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".CoordinadorActivity" />
        <activity android:name=".EnfermeriaActivity" />
        <activity android:name=".DoctorActivity" />
        <activity android:name=".PacienteActivity" />

        <activity android:name=".RegistroUsuarioActivity" />
        <activity android:name=".RegistrarCitaActivity" />
        <activity android:name=".RegistrarDiagnosticoActivity" />
        <activity android:name=".RegistrarDoctorActivity" />
        <activity android:name=".RegistrarEnfermeroActivity" />
        <activity android:name=".RegistrarCoordinadorActivity" />
        <activity android:name=".RegistrarExpedienteEnfActivity" />
        <activity android:name=".RegistrarPacienteEnfActivity" />
        <activity android:name=".RegistrarRecetaActivity" />
        <activity android:name=".VerCitasActivity" />

        <activity android:name=".ConsultarCitasActivity" />
        <activity android:name=".ConsultarDoctoresActivity" />
        <activity android:name=".ConsultarEnfermerosActivity" />
        <activity android:name=".ConsultarCoordinadoresActivity" />
        <activity android:name=".ConsultarPacientesActivity" />
        <activity android:name=".ListaDiagnosticosActivity" />
        <activity android:name=".ListaExpedientesActivity" />
        <activity android:name=".ListaPacientesEnfActivity" />

        <activity android:name=".VerExpedientesActivity" />
        <activity android:name=".VerRecetasActivity" />
        <activity android:name=".VerRecetasPacienteActivity" />
        <activity android:name=".EditarUsuarioActivity" />

        <uses-permission android:name="android.permission.INTERNET" />
    </application>
</manifest>