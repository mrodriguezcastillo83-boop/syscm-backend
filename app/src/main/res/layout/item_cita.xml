<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvIdCita"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cita #000"
            android:textColor="#718096"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvFechaCita"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Fecha: 00/00/0000"
            android:textColor="#008080"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvEstadoCita"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Estado: Pendiente"
            android:textColor="#D69E2E"
            android:textStyle="bold"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/tvPacienteCita"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Paciente: Nombre"
            android:textSize="16sp"
            android:textColor="#1A365D"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvMotivoCita"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Motivo: Consulta general"
            android:textColor="#4A5568"
            android:textSize="14sp"
            android:maxLines="2"
            android:ellipsize="end"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>