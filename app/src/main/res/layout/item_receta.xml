<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvIdReceta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Receta #000"
            android:textColor="#008080"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvIdDiagnosticoReceta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Diagnóstico ID: 0"
            android:textSize="12sp"
            android:textColor="#4A5568"
            android:layout_marginTop="2dp"/>

        <TextView
            android:id="@+id/tvMedicamentosReceta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Medicamentos: ..."
            android:textSize="14sp"
            android:textColor="#2D3748"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/tvIndicacionesReceta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Indicaciones: ..."
            android:textSize="14sp"
            android:textColor="#718096"
            android:layout_marginTop="4dp"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>