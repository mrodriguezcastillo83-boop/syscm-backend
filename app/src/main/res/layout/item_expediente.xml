<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvIdExpediente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Expediente #000"
            android:textColor="#008080"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvFechaExpediente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Creado: 2026-05-30"
            android:textColor="#718096"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/tvIdPacienteExp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Paciente ID: 000"
            android:textColor="#1A365D"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvAntecedentes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Antecedentes: ..."
            android:textColor="#2D3748"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/tvAlergias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Alergias: ..."
            android:textColor="#C53030"
            android:textStyle="italic"
            android:textSize="14sp"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>